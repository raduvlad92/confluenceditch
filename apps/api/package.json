{
  "name": "@confluenceditch/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@confluenceditch/types": "workspace:*",
    "@prisma/client": "^5.22.0",
    "better-auth": "^1.2.7",
    "bullmq": "^5.25.6",
    "cheerio": "^1.0.0",
    "domhandler": "^5.0.3",
    "fastify": "^5.1.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.1",
    "ioredis": "^5.4.1",
    "resend": "^4.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
